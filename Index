        function DashboardView({ records }) {
            const [selectedRecord, setSelectedRecord] = useState(null);

            const exportToCSV = () => {
                if (records.length === 0) {
                    alert("No records to export yet.");
                    return;
                }
                
                // 1. Define headers
                const headers = ["Student Name", "Class", "Date", "Total Marks", "CEFR Level"];
                
                // 2. Format rows and escape any commas or quotes safely
                const escapeCsv = (str) => `"${String(str || '').replace(/"/g, '""')}"`;
                
                const rows = records.map(r => {
                    const cefr = getCEFRLevel(r.totalMarks);
                    return `${escapeCsv(r.studentName)},${escapeCsv(r.className)},${escapeCsv(r.date)},${r.totalMarks},${escapeCsv(cefr.level)}`;
                });
                
                // 3. Combine headers and rows
                const csvContent = [headers.join(","), ...rows].join("\n");
                
                // 4. Create a Blob for robust downloading
                const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                const url = URL.createObjectURL(blob);
                
                // 5. Trigger the download
                const link = document.createElement("a");
                link.setAttribute("href", url);
                link.setAttribute("download", `MPT4_Marks_${new Date().toISOString().split('T')[0]}.csv`);
                document.body.appendChild(link);
                link.click();
                
                // 6. Clean up
                document.body.removeChild(link);
                URL.revokeObjectURL(url);
            };

