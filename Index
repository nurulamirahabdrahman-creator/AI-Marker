        function App() {
            const [user, setUser] = useState(null);
            const [activeTab, setActiveTab] = useState('scan');
            const [currentScan, setCurrentScan] = useState(null);
            const [records, setRecords] = useState([]);
            const [userId, setUserId] = useState(null);

            // Connect to Cloud Database Auth
            useEffect(() => {
                const interval = setInterval(() => {
                    if (window.fbAuth && window.fbAuth.currentUser) {
                        setUserId(window.fbAuth.currentUser.uid);
                        clearInterval(interval);
                    }
                }, 500);
                return () => clearInterval(interval);
            }, []);

            // Listen for Cloud Database Updates
            useEffect(() => {
                if (!window.fbDb || !userId || !user) return;
                const colRef = window.fbFunctions.collection(window.fbDb, 'artifacts', window.appId, 'users', userId, 'verified_results');
                
                const unsubscribe = window.fbFunctions.onSnapshot(colRef, (snapshot) => {
                    const fetchedRecords = [];
                    snapshot.forEach(doc => {
                        fetchedRecords.push({ id: doc.id, ...doc.data() });
                    });
                    fetchedRecords.sort((a, b) => b.id - a.id); // Sort by newest first
                    setRecords(fetchedRecords);
                }, (error) => {
                    console.error("Error syncing with cloud:", error);
                });

                return () => unsubscribe();
            }, [userId, user]);

            const handleScanComplete = (base64) => {
                setCurrentScan(base64);
                setActiveTab('review');
            };

            const handleReviewComplete = async (result) => {
                if (window.fbDb && userId) {
                    try {
                        const colRef = window.fbFunctions.collection(window.fbDb, 'artifacts', window.appId, 'users', userId, 'verified_results');
                        const dataToSave = { ...result };
                        // Imej kini dikekalkan (tidak dipadam) kerana ia telah dimampatkan
                        await window.fbFunctions.addDoc(colRef, dataToSave);
                    } catch (error) {
                        console.error("Failed to save to cloud:", error);
                    }
                } else {
                    setRecords(prev => [result, ...prev]); // Local fallback
                }

                setCurrentScan(null);
                setActiveTab('dashboard');
            };

            if (!user) {
                return <LoginView onLogin={(userData) => setUser(userData)} />;
            }

            return (
                <Layout user={user} activeTab={activeTab} setActiveTab={setActiveTab} onLogout={() => setUser(null)}>
                    {activeTab === 'scan' && <ScannerView onScanComplete={handleScanComplete} />}
                    {activeTab === 'dashboard' && <DashboardView records={records} />}
                    {activeTab === 'review' && (
                        currentScan ? 
                            <ReviewWorkspace imageSrc={currentScan} onComplete={handleReviewComplete} onCancel={() => {setCurrentScan(null); setActiveTab('scan');}} /> 
                            : 
                            <div className="h-full flex items-center justify-center p-6 text-center">
                                <div>
                                    <i className="fas fa-file-excel text-5xl text-gray-300 mb-4"></i>
                                    <h2 className="text-xl font-bold text-gray-600 mb-4">No paper currently under review.</h2>
                                    <button onClick={() => setActiveTab('scan')} className="bg-brand-primary text-white font-bold px-6 py-2 rounded-xl">Go to Scanner</button>
                                </div>
                            </div>
                    )}
                </Layout>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
